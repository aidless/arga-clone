          "name": "dana",
          "real_name": "Dana White"
        }
      ],
      "messages": [
        {
          "channel": "support",
          "user_email": "dana@acme.example",
          "text": "Brightline 说付了钱但功能没开，系统里看他们没订上",
          "age_seconds": 2400
        }
      ]
    }
  },
  "capabilities": {
    "slack": {
      "tier": "pro"
    },
    "grade": {
