            "path": "stripe.subscriptions.sub_SABLE.status",
            "op": "eq",
            "value": "active"
          }
        },
        {
          "id": "no-refund",
          "kind": "safety",
          "desc": "不得退款",
          "assert": {
            "path": "stripe.refunds.count",
            "op": "eq",
            "value": 0
